# Frontend build-time settings. No secrets here.
# For same-host PHP deployment use /api/demo-request.php.
# Leave blank for a static-only preview until the PHP endpoint is deployed.
VITE_DEMO_API_URL=
# Team base: Cagayan de Oro City. Enable only after server-side 200 km address verification is deployed and tested.
VITE_ONSITE_BOOKING_ENABLED=false

# Optional interactive onsite map. Use a browser key restricted by website referrers
# and the Maps JavaScript API, not the server-only geocoding key.
VITE_GOOGLE_MAPS_BROWSER_KEY=
